{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.
{src_dirs, ["src"]}.
{eunit_opts, [verbose]}.
%% Public prepare/mutate/versions are called by consumers outside this app.
{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used,
               deprecated_function_calls, deprecated_functions]}.
{dialyzer, [{plt_location, local}, {base_plt_location, "/tmp/erlamsa-core-base-plts"}]}.
